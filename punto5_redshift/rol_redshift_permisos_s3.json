{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketPunto5",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::$BUCKET"
    },
    {
      "Sid": "LeerArchivosPunto5",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::$BUCKET/punto5/*"
    }
  ]
}